# ── Docker / AzerothCore ────────────────────────────────────────────────
DOCKER_DB_ROOT_PASSWORD=change-me-db-password
DOCKER_IMAGE_TAG=master
DOCKER_DB_EXTERNAL_PORT=3306
DOCKER_AUTH_EXTERNAL_PORT=3724
DOCKER_WORLD_EXTERNAL_PORT=8085
DOCKER_SOAP_EXTERNAL_PORT=7878
DOCKER_WEB_EXTERNAL_PORT=8080
DOCKER_DOWNLOAD_EXTERNAL_PORT=8081

# ── Webapp ──────────────────────────────────────────────────────────────
# How the portal container runs.
#
#   prod  production build — what a server people can reach should use
#   dev   hot reload; `next dev` recompiles per request, ships unminified
#         bundles, and its error overlay shows stack traces to whoever hits
#         a 500. Convenient locally, not something to leave on a public host.
#
# Read by every task, so switching stays switched:
#   task dev / task prod   change it and restart the portal
#   task mode              show which one is active
WEBAPP_MODE=prod

# Long random string used to sign login session cookies. Required — the stack
# refuses to start without it, because anyone who can guess this value can
# forge an admin session. Generate one with:
#
#   openssl rand -base64 32
#
SESSION_SECRET=

# Hostname players reach this machine on — a domain, a LAN IP, whatever they
# type in the browser. `localhost` works only if you browse from this machine;
# set it to something else and remote players get working invite links and a
# working client download.
PUBLIC_HOST=localhost

# The portal and the client-download server default to PUBLIC_HOST on the
# ports published above (http://$PUBLIC_HOST:8080 and :8081). Set these only
# to override that — e.g. behind a reverse proxy doing HTTPS on port 443.
# They must share a hostname, or the login cookie is not sent with the
# download request; ports may differ, cookies are not port-scoped.
#SITE_URL=https://wow.example.com
#DOWNLOAD_URL=https://dl.wow.example.com

# Path on the host to the game client zip, served at /files/client.zip.
# If the path does not exist, Docker mounts an empty directory in its place
# and /files/client.zip simply 404s.
CLIENT_ZIP_PATH=./ChromieCraft_3.3.5a.zip

# Filename players' browsers save the client as.
CLIENT_ZIP_NAME=ChromieCraft_3.3.5a.zip

# GM-level-3 account the webapp uses for the live SOAP console.
# Create it after first start (see README) and fill these in.
SOAP_USER=admin
SOAP_PASS=

# ── Network Tunnels (Optional) ─────────────────────────────────────────────
# ZeroTier Virtual Network ID (starts container with `task zerotier:up`)
ZEROTIER_NETWORK_ID=

# Cloudflare Tunnel Token (starts container with `task cloudflare:up`)
CLOUDFLARE_TUNNEL_TOKEN=

# ── Playerbots Mode (Optional) ────────────────────────────────────────────────
# Runs a second AzerothCore realm with mod-playerbots built from source.
# Both realms share ac-database and ac-authserver; players pick from the
# WoW client realm list.
#
# One-time setup:
#   task playerbots:build    ← compile from source (30–60 min; Docker-cached)
# Then set PLAYERBOTS_MODE=1 below and run task up  (or task playerbots:up).
PLAYERBOTS_MODE=

# External port for playerbots game traffic (maps to internal 8085).
DOCKER_PB_WORLD_EXTERNAL_PORT=8086

# Host-bound SOAP port for the playerbots worldserver admin API.
DOCKER_PB_SOAP_EXTERNAL_PORT=7879

