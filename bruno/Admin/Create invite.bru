meta {
  name: Create invite
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/admin/invites
  body: json
  auth: none
}

body:json {
  {
    "note": "created from the Bruno collection",
    "expiresDays": 7
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("inviteToken", res.getBody().token);
  }
}

tests {
  test("mints a single-use link", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().url).to.be.a("string");
  });
}

docs {
  Publishes `inviteToken` for `Auth / Check invite token` and
  `Auth / Register with invite`. Set `expiresDays` to 0 for a link that never
  expires; the server caps it at 365.
}
