meta {
  name: Login (admin)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{adminUser}}",
    "password": "{{adminPass}}"
  }
}

tests {
  test("logs in", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().ok).to.equal(true);
  });
}

docs {
  Authenticates as a GM-level-3 account, unlocking the Admin folder.

  - `401` — wrong username or password.
  - `403` — the account exists and the password is right, but it is **banned**.
    Check `acore_auth.account_banned`.
}
