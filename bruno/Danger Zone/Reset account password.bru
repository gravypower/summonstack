meta {
  name: Reset account password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/admin/accounts/actions
  body: json
  auth: none
}

body:json {
  {
    "accountId": {{targetAccountId}},
    "action": "password",
    "newPassword": "ChangeMe123"
  }
}

docs {
  Rewrites the SRP6 salt and verifier and clears `session_key`, so any cached
  game session is invalidated too. This is the game password as well as the
  website password — they are the same credential.
}
