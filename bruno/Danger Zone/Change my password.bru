meta {
  name: Change my password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/account/password
  body: json
  auth: none
}

body:json {
  {
    "currentPassword": "{{adminPass}}",
    "newPassword": "ChangeMe123"
  }
}

docs {
  Changes the password of the **currently logged-in** account, verifying the
  current one first.

  Listed here because a successful send invalidates the credentials in your
  environment — update `adminPass` or `playerPass` afterwards or later logins
  will fail with 401.
}
