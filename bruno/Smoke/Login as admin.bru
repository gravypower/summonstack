meta {
  name: Login as admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{adminUser}}",
    "password": "{{adminPass}}"
  }
}

tests {
  test("logs in", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().ok).to.equal(true);
  });

  test("returns the normalised username", function () {
    expect(res.getBody().username).to.be.a("string");
  });
}

docs {
  Sets the `ss_session` cookie for every request that follows in this run.
}
