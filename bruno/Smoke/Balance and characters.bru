meta {
  name: Balance and characters
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/shop/me
  body: none
  auth: none
}

tests {
  test("returns a balance", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().balance).to.be.a("number").and.to.be.at.least(0);
  });

  test("returns the account's characters", function () {
    expect(res.getBody().characters).to.be.an("array");
  });
}
